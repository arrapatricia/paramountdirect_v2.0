// Paramount Direct admin dashboard - backend data model.
//
// Field names deliberately mirror the TypeScript interfaces already used by
// the frontend (see paramountdirect_v2/src/components/*_types.ts and the
// component files referenced above each model) so the API can be consumed
// with minimal translation. Product-line scoping ("PD Life" / "OFW" /
// "CTPL" / "GTP") is kept as plain strings rather than a Prisma enum because
// the frontend's own literal union type includes a space ("PD Life"), and
// validating that set belongs in the API layer (zod), not the DB layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users, roles & permissions
// ---------------------------------------------------------------------------

enum UserStatus {
  Active
  Inactive
}

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(Active)
  // Product lines this user's account can switch into, e.g. ["PD Life", "OFW"].
  assignedProducts String[]
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  auditLogs AuditLog[]

  @@index([roleId])
  @@index([branchId])
}

model Role {
  id             String   @id @default(cuid())
  name           String
  // Which product system this role belongs to: "PD Life" | "OFW" | "CTPL" | "GTP".
  productScope   String
  // True for the newer Direct Marketing-specific roles (Operations, Marketing,
  // Contact Center) as opposed to the larger legacy PD Life role list.
  isDirectMarketing Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([name, productScope])
}

model RolePermission {
  id         String  @id @default(cuid())
  roleId     String
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleName String
  canRead    Boolean @default(false)
  canWrite   Boolean @default(false)
  canDelete  Boolean @default(false)

  @@unique([roleId, moduleName])
}

// ---------------------------------------------------------------------------
// Branch directory
// ---------------------------------------------------------------------------

enum BranchDivision {
  LIFE
  NON_LIFE
}

enum BranchStatus {
  Active
  Inactive
}

model Branch {
  id        String         @id @default(cuid())
  division  BranchDivision
  region    String
  province  String
  city      String
  address   String
  barangay  String?
  zipcode   String
  mobile    String
  telephone String
  fax       String?
  email     String?
  website   String
  status    BranchStatus   @default(Active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  users User[]
}

// ---------------------------------------------------------------------------
// PD Life applications
// ---------------------------------------------------------------------------

// Mirrors App.tsx's ScreeningItem plus the plan-category split used to route
// applications to application_detail_health.tsx / _lifeaccident.tsx /
// _comprehensive.tsx. Category-specific fields (medical questions,
// beneficiaries, etc.) live in `details` as JSON rather than as separate
// tables/columns, since each category's field list can evolve independently
// and isn't queried relationally elsewhere.
enum PdLifePlanCategory {
  Health
  LifeAccident
  Comprehensive
}

enum PdLifeStatus {
  Received
  For_Verification
  For_Evaluation
  Paid
  Issued
}

model PdLifeApplication {
  id            String             @id @default(cuid())
  // Human-readable sequential reference (1, 2, 3, ...), assigned at
  // creation via a native Postgres sequence - display as a zero-padded
  // 7-digit string (e.g. "0000001"). Distinct from `policyNumber`, which
  // is only assigned once the application is actually transmitted to iPeak.
  applicationSeq Int               @default(autoincrement())
  payor         String
  planCategory  PdLifePlanCategory
  planCode      String
  planDesc      String
  premium       String
  source        String
  dateReceived  DateTime
  dateScreened  DateTime?
  screenedBy    String?
  status        PdLifeStatus       @default(Received)
  // Category-specific structured data (applicant details, beneficiaries,
  // medical declarations, etc.) - shape depends on planCategory.
  details       Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Policy number assigned once the application is transmitted to iPeak
  // (LEAP Services); doubles as iPeak's ApplicationID/PolicyNo.
  policyNumber     String?      @unique
  // Insured's personal details, mirroring the frontend's PolicyOwnerInfo -
  // in this product line the insured is always their own policy owner.
  firstName        String?
  middleName       String?
  lastName         String?
  otherName        String?
  gender           Gender?
  civilStatus      CivilStatus?
  birthdate        DateTime?
  placeOfBirth     String?
  nationality      String?
  billingAddress   String?
  residingAddress  String?
  heightCm         Float?
  weightKg         Float?
  // Employment / financial details, mirroring the category `details` blob.
  occupation       String?
  companyAddress   String?
  sourceOfFunds    String?
  tin              String?
  sssNo            String?
  mobileNumber     String?
  telephoneNumber  String?
  email            String?

  beneficiaries          PdLifeBeneficiary[]
  ipeakRequests          PdLifeIpeakRequest[]
  // Billing/ledger side of the same policy, once issued - keyed off the same
  // policy number iPeak assigned above (see LifePaymentTransaction.policyNo).
  lifePaymentTransaction LifePaymentTransaction?

  @@index([status])
  @@index([planCategory])
}

model PdLifeBeneficiary {
  id             String            @id @default(cuid())
  applicationId  String
  application    PdLifeApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fullName       String
  birthdate      DateTime
  relationship   String
  sharePercent   Float?
  designation    String?
  trusteeName    String?
  createdAt      DateTime          @default(now())

  @@index([applicationId])
}

enum PdLifeIpeakMethod {
  NewBusiness
  UpdateStatus
  // iPeak's "Policy Inquiry" method (PDPolicy + PolCoverages/PolBeneficiaries/
  // PayHistory/Loans) - see server/src/services/ipeak/policyInquiry.ts.
  PolicyInquiry
}

// Audit / retry trail for every call made to iPeak (LEAP Services) for a PD
// Life application - mirrors the legacy system's LifeMbPendingRequest.
model PdLifeIpeakRequest {
  id             String            @id @default(cuid())
  applicationId  String
  application    PdLifeApplication @relation(fields: [applicationId], references: [id])
  policyNumber   String
  method         PdLifeIpeakMethod
  requestPayload Json
  responseBody   Json?
  statusCode     Int?
  success        Boolean           @default(false)
  errorMessage   String?
  retryCount     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([applicationId])
  @@index([policyNumber])
}

// One row per PD Life plan code, holding the last sequential number used in
// that plan's policy number (format PLANCODE-NNNNNN-D, e.g. "HCP-043385-0" -
// matches the real numbering scheme used on Paramount's own AS400 side).
// Incremented atomically so concurrent submissions never collide.
model PdLifePolicyNumberSequence {
  planCode   String @id
  lastNumber Int    @default(0)
}

// ---------------------------------------------------------------------------
// OFW applications
// ---------------------------------------------------------------------------

enum Gender {
  Male
  Female
}

enum CivilStatus {
  Single
  Married
  Widower
  Separated
}

enum SalaryCurrency {
  PHP
  USD
  HKD
  Others
}

enum NatureOfEmployment {
  Direct_hired
  Balik_Manggagawa
}

enum CoverageType {
  Land_based
  Sea_based
}

enum DocumentStatus {
  Uploaded
  Missing
}

enum OfwStatus {
  Received
  Cancelled
  Duplicate
  Reversed
}

// OFW-only caveat: unlike CTPL/GTP's straight-through website payment, an
// issuer must first verify the employment contract before the client is
// even sent instructions to pay - see OfwApplication.employmentVerified.
enum EmploymentVerifiedStatus {
  Pending
  Yes
  No
}

model OfwApplication {
  id                 String             @id @default(cuid())
  lastName           String
  firstName          String
  middleName         String
  gender             Gender
  civilStatus        CivilStatus
  birthdate          DateTime
  placeOfBirth       String
  phAddress          String
  phRegion           String             @default("")
  phCity             String
  phBarangay         String             @default("")
  phone              String
  email              String
  referralSource     String

  natureOfEmployment NatureOfEmployment
  coverageType       CoverageType
  occupation         String
  passportNumber     String
  salaryAmount       Float
  salaryCurrency     SalaryCurrency
  employerName       String
  employerCountry    String
  contractStart      DateTime
  contractEnd        DateTime
  insuranceStart     DateTime
  isConflictZone     Boolean            @default(false)

  passportDoc            DocumentStatus @default(Missing)
  visaDoc                DocumentStatus @default(Missing)
  employmentContractDoc  DocumentStatus @default(Missing)
  medicalCertificateDoc  DocumentStatus @default(Missing)

  premium       String
  dateReceived  DateTime
  status        OfwStatus  @default(Received)
  screenedBy    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // See EmploymentVerifiedStatus - must be verified before a payment
  // instruction can be sent, which itself must happen before isPaid can be true.
  employmentVerified     EmploymentVerifiedStatus @default(Pending)
  paymentInstructionSent Boolean                  @default(false)
  isPaid                 Boolean                  @default(false)

  // At least one required, up to three - see OfwBeneficiary.
  beneficiaries OfwBeneficiary[]

  // Assigned once the policy is issued / once payment is confirmed - also
  // exposed on NonLifePaymentTransaction rows for display/search even when
  // ofwApplicationId is set, since that's the natural lookup key for a payment.
  policyNumber  String?    @unique
  referenceNo   String?    @unique

  // Real FK back-relation - see NonLifePaymentTransaction.ofwApplicationId.
  paymentTransactions NonLifePaymentTransaction[]

  @@index([status])
}

model OfwBeneficiary {
  id             String          @id @default(cuid())
  applicationId  String
  application    OfwApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fullName       String
  relationship   String
  birthdate      DateTime
  createdAt      DateTime        @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// CTPL applications
// ---------------------------------------------------------------------------

enum CtplPolicyType {
  Private_Car
  Commercial_Vehicle
  Motorcycle
}

enum CtplRenewalType {
  New_1_Year
  Renewal
}

enum CtplClientType {
  Individual
  Corporate_without_assignee
  Corporate_with_assignee
}

enum CtplStatus {
  Completed
  Spoiled
  Duplicate
  Reversed
  Cancelled
}

model CtplApplication {
  id             String          @id @default(cuid())
  policyType     CtplPolicyType
  mvType         String
  renewalType    CtplRenewalType

  clientType         CtplClientType
  ownerFirstName      String
  ownerMiddleName     String
  ownerSurname        String
  ownerAddress        String         @default("")
  ownerRegion         String         @default("")
  ownerCity           String         @default("")
  ownerBarangay       String         @default("")
  sameAsOwner         Boolean        @default(true)
  applicantFirstName  String
  applicantSurname    String
  email               String
  mobileNumber        String

  plateNumber    String
  mvFileNumber   String
  chassisNumber  String

  requiresCOV    Boolean  @default(false)

  premium       String
  dateReceived  DateTime
  status        CtplStatus @default(Completed)
  screenedBy    String?
  isPaid        Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Assigned once the policy is issued / once payment is confirmed - also
  // exposed on NonLifePaymentTransaction rows for display/search even when
  // ctplApplicationId is set, since that's the natural lookup key for a payment.
  policyNumber  String?    @unique
  referenceNo   String?    @unique

  // Real FK back-relation - see NonLifePaymentTransaction.ctplApplicationId.
  paymentTransactions NonLifePaymentTransaction[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// GTP applications
// ---------------------------------------------------------------------------

enum GtpTravelType {
  International
  Domestic
}

enum GtpApplicationType {
  Individual
  Family
}

enum GtpPlanVariant {
  Single_Trip
  Multi_Trip_90
  Multi_Trip_180
}

enum GtpStatus {
  Received
  Cancelled
  Duplicate
}

model GtpApplication {
  id             String        @id @default(cuid())
  travelType     GtpTravelType
  destinations   String[]
  departureDate  DateTime
  returnDate     DateTime
  daysOfTravel   Int
  applicationType GtpApplicationType

  travelerFirstName String
  travelerSurname   String
  birthdate         DateTime
  email             String
  mobileNumber      String

  planVariant             GtpPlanVariant
  cruiseCoverage          Boolean @default(false)
  hazardousSportsCoverage Boolean @default(false)
  isSchengenDestination   Boolean @default(false)

  premium       String
  dateReceived  DateTime
  status        GtpStatus @default(Received)
  screenedBy    String?
  isPaid        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Assigned once the policy is issued / once payment is confirmed - also
  // exposed on NonLifePaymentTransaction rows for display/search even when
  // gtpApplicationId is set, since that's the natural lookup key for a payment.
  policyNumber  String?   @unique
  referenceNo   String?   @unique

  // Real FK back-relation - see NonLifePaymentTransaction.gtpApplicationId.
  paymentTransactions NonLifePaymentTransaction[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Life payment transactions & ledger (PD Life)
// ---------------------------------------------------------------------------

enum PolicyStatus {
  Inforced
  Lapsed
  Terminated
  Matured
  Involuntary
  Voluntary
  Surrender
}

// Named to mirror NonLifePaymentTransaction below - this is PD Life's side
// of the payment/ledger split, previously just "PaymentTransaction" back
// when it was the only one.
model LifePaymentTransaction {
  id               String   @id @default(cuid())
  // References the PD Life application this ledger belongs to via its
  // issued policy number - a LifePaymentTransaction can only exist once an
  // application has actually been issued a policy number by iPeak.
  policyNo         String            @unique
  application      PdLifeApplication @relation(fields: [policyNo], references: [policyNumber])
  title            String
  firstName        String
  middleName       String
  lastName         String
  birthdate        DateTime
  gender           String
  currentAge       Int
  issueAge         Int
  address          String
  mobileNumber     String
  telephoneNumber  String
  emailAddress     String

  policyStatus     PolicyStatus
  hcrStatus        String
  hcrUnit          String
  premium          Float
  hcrPremium       Float
  deposit          Float
  underpay         Float
  dueDate          DateTime
  payType          String
  cashValue        Float
  lifeBenefits     Float
  accidentalBenefits Float
  mode             String
  issueDate        DateTime
  effectivityDate  DateTime
  policyDate       DateTime
  expiryDate       DateTime

  planCode  String
  planDesc  String
  orDate    DateTime?
  orNumber  String?

  // Ledger/installment detail (iPeak's PayHistory) is NOT duplicated into its
  // own table - it's read on demand from the most recent successful
  // PdLifeIpeakRequest{method: PolicyInquiry} row's responseBody for this
  // policy, via distributePolicyInquiry.ts. Avoids keeping a second copy of
  // the same data in sync with every inquiry call.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Payment transactions (Non-Life: CTPL / OFW / GTP)
// ---------------------------------------------------------------------------

enum NonLifeProduct {
  CTPL
  OFW
  GTP
}

// CTPL/OFW/GTP are straight-through, one-time payments (no installment
// ledger like PD Life's PaymentTransaction), so this is a flat record per
// payment rather than a per-policy ledger. `product` says which of the three
// FK columns below is actually populated - Prisma has no native polymorphic
// relation, so each possible parent gets its own nullable FK instead of one
// shared column, which is also why exactly one of ctplApplicationId /
// ofwApplicationId / gtpApplicationId should be set per row (enforced in the
// API layer, not the DB). A row can also exist with none set at all, for a
// payment a cashier logs manually with no matching application on file.
model NonLifePaymentTransaction {
  id           String         @id @default(cuid())
  product      NonLifeProduct
  policyNumber String
  referenceNo  String
  payorName    String
  planLabel    String
  premium      String
  dateReceived DateTime

  ctplApplicationId String?
  ctplApplication   CtplApplication? @relation(fields: [ctplApplicationId], references: [id])
  ofwApplicationId  String?
  ofwApplication    OfwApplication?  @relation(fields: [ofwApplicationId], references: [id])
  gtpApplicationId  String?
  gtpApplication    GtpApplication?  @relation(fields: [gtpApplicationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([product])
  @@index([policyNumber])
  @@index([referenceNo])
}

// ---------------------------------------------------------------------------
// Generated policy documents (Policy Schedule, COC, OR, Service Invoice, ...)
// ---------------------------------------------------------------------------

enum DocumentApplicationType {
  PdLife
  OFW
  CTPL
  GTP
}

// One immutable row per generated document, written once (when a
// transaction's isPaid flips true) and never overwritten - the S3 object
// itself is the source of truth for the bytes, this row is just the pointer
// plus enough metadata to list/audit what's been generated for an
// application. See PolicyDocumentsSection in policy_documents.tsx for the
// frontend side this backs.
model GeneratedDocument {
  id              String                  @id @default(cuid())
  applicationType DocumentApplicationType
  applicationId   String
  // Matches the frontend's PolicyDocumentSpec.key, e.g. "policy-schedule", "or".
  docKey          String
  s3Key           String                  @unique
  contentType     String                  @default("application/pdf")
  generatedAt     DateTime                @default(now())
  generatedBy     String?

  @@index([applicationType, applicationId])
}

// ---------------------------------------------------------------------------
// Audit logs
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userLabel String   // denormalized display name, kept even if the user is later deleted
  role      String
  action    String
  module    String
  details   String
  ipAddress String

  @@index([userId])
  @@index([module])
}
