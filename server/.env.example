# Copy to .env and adjust as needed
DATABASE_URL=postgresql+psycopg://pd_app:pd_dev_password@localhost:5432/paramountdirect
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default admin bootstrapped by the seed script
FIRST_ADMIN_EMAIL=admin@paramountdirect.example.com
FIRST_ADMIN_PASSWORD=admin12345
