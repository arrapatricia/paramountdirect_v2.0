# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string.
# Local install example:  postgresql://postgres:postgres@localhost:5432/paramountdirect
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paramountdirect"

# Secret used to sign JWTs - use a long random string in real environments.
JWT_SECRET="change-me-to-a-long-random-string"

# How long an access token stays valid.
JWT_EXPIRES_IN="8h"

PORT=4000

# Origin(s) allowed to call this API from the browser (comma-separated).
CORS_ORIGIN="http://localhost:5173"

# iPeak (LEAP Services) integration - see the "LEAP Services System
# Documentation" doc for the current values for your environment (UAT vs
# production). IPEAK_SERVICE_URL must already include the Public Application
# Key segment (e.g. ".../workflowservice.svc/<your-public-app-key>") - only
# the web-method path (lifemb/newbusiness, lifemb/update) is appended per call.
IPEAK_SERVICE_URL="http://ws.paramount.com.ph/test/workflowservice.svc/change-me"
IPEAK_PRIVATE_KEY="change-me"

# S3 storage for generated policy documents (Policy Schedule, COC, OR, etc.).
# The IAM user behind these keys should be scoped to only this bucket
# (s3:PutObject/s3:GetObject on arn:aws:s3:::<bucket>/*) - see DEVELOPER_HANDOVER.md.
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="change-me"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"

# Shared secret the public paramountdirect.com website sends as the
# X-Api-Key header when it POSTs a newly submitted PD Life application to
# POST /api/ingest/pd-life, so it lands in Application Screening automatically.
# Long random string; same value must be configured on the website's side.
WEBSITE_INGEST_API_KEY="change-me-to-a-long-random-string"
