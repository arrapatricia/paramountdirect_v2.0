# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string.
# Local install example:  postgresql://postgres:postgres@localhost:5432/paramountdirect
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paramountdirect"

# Secret used to sign JWTs - use a long random string in real environments.
JWT_SECRET="change-me-to-a-long-random-string"

# How long an access token stays valid.
JWT_EXPIRES_IN="8h"

PORT=4000

# Origin(s) allowed to call this API from the browser (comma-separated).
CORS_ORIGIN="http://localhost:5173"
